<Window x:Class="Deadsmile.Launcher.Views.AchievementWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid x:Name="ToastRoot" RequestedTheme="Dark" Background="Transparent">
  <Border x:Name="ToastSurface" Background="#FF242424" BorderBrush="#FF454545" BorderThickness="1" Padding="10,8" CornerRadius="22">
   <Grid ColumnSpacing="20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Viewbox Width="24" Height="24" VerticalAlignment="Center"><FontIcon x:Name="ToastIcon" Glyph="&#xE734;" FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/></Viewbox>
    <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
     <TextBlock x:Name="Heading" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"/>
     <TextBlock x:Name="AchievementTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
   </Grid>
  </Border>

 </Grid>
</Window>
