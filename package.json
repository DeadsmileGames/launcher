{
  "name": "deadsmile-games-launcher",
  "version": "1.0.3",
  "description": "Deadsmile Games Launcher",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "web": "vite",
    "build": "vite build",
    "build:windows": "npm run build && electron-builder --win --publish never",
    "package:update": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "@rollup/rollup-win32-x64-msvc": "^4.63.1",
    "itchio-downloader": "^1.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },

  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.0.0",
    "vite": "^7.0.0",
    "wait-on": "^9.0.0"
  },
  "build": {
    "appId": "com.deadsmile.games.launcher",
    "productName": "Deadsmile Games Launcher",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/favicon.ico",
      "artifactName": "Deadsmile-Games-Launcher-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "asarUnpack": [
      "electron/updater.cjs"
    ]
  }
}