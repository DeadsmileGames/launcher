<Window x:Class="Deadsmile.Launcher.Views.AchievementWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid x:Name="ToastRoot" RequestedTheme="Dark" Background="Transparent">
  <Border x:Name="ToastSurface" Background="#FF242424" BorderBrush="#FF454545" BorderThickness="1" Padding="10,8" CornerRadius="22">
   <Grid ColumnSpacing="20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Viewbox Width="24" Height="24" VerticalAlignment="Center"><FontIcon x:Name="ToastIcon" Glyph="&#xE734;" FontFamily="Segoe MDL2 Assets" Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/></Viewbox>
    <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
     <TextBlock x:Name="Heading" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"/>
     <TextBlock x:Name="AchievementTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
   </Grid>
  </Border>
  <Border x:Name="ShortcutSurface" Visibility="Collapsed" Background="#FFF3F3F3" BorderBrush="#FFD7D7D7" BorderThickness="1" Padding="18,14" CornerRadius="24" RequestedTheme="Light">
   <Grid ColumnSpacing="16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Width="44" Height="44" CornerRadius="14" Background="#FFE3E3E3" VerticalAlignment="Center">
     <FontIcon x:Name="ShortcutIcon" Glyph="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#FF252525" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
     <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="ShortcutHeading" Text="DeadBar" FontSize="16" FontWeight="SemiBold" Foreground="#FF202020" VerticalAlignment="Center"/>
      <TextBlock x:Name="ShortcutKey" Grid.Column="1" Text="Ctrl + D" FontSize="13" FontWeight="SemiBold" Foreground="#FF404040" VerticalAlignment="Center"/>
     </Grid>
     <TextBlock x:Name="ShortcutMessage" FontSize="13" TextWrapping="Wrap" Foreground="#FF4A4A4A" MaxLines="1" TextTrimming="CharacterEllipsis"/>
     <Border x:Name="ShortcutMeter" Height="6" Background="#FFD8D8D8" CornerRadius="3">
      <Border Width="140" Background="#FF86D900" HorizontalAlignment="Left" CornerRadius="3"/>
     </Border>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
