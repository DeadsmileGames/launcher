{
  "name": "deadsmile-games-launcher",
  "version": "1.0.2",
  "description": "Deadsmile Games Launcher",
  "author": "Deadsmile Games",
  "license": "MIT",
  "homepage": "https://deadsmilegames.vercel.app",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "web": "vite",
    "build": "vite build",
    "build:windows": "npm run build && electron-builder --win --publish never",
    "build:store": "npm run build && electron-builder --config electron-builder.store.cjs --win appx --x64 --publish never",
    "package:update": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "@itchio/butlerd": "^15.0.0",
    "@phosphor-icons/react": "^2.1.7",
    "@rollup/rollup-win32-x64-msvc": "^4.63.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.5",
    "electron": "^44.3.0",
    "electron-builder": "^26.0.0",
    "vite": "^7.0.0",
    "wait-on": "^9.0.0"
  },
  "build": {
    "appId": "com.deadsmile.games.launcher",
    "productName": "Deadsmile Games Launcher",
    "compression": "maximum",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/favicon.ico",
      "artifactName": "Deadsmile-Games-Launcher-Setup-${version}.${ext}",
      "protocols": [
        {
          "name": "Deadsmile Games Launcher",
          "schemes": [
            "deadsmile"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "electronFuses": {
      "runAsNode": true,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    }
  }
}
