<Window x:Class="Deadsmile.Launcher.Views.AchievementWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid RequestedTheme="Dark" Background="Transparent" Padding="10">
  <Border Style="{StaticResource Panel}" Padding="20">
   <Grid ColumnSpacing="16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <SymbolIcon Symbol="Favorite" Foreground="{ThemeResource SystemControlHighlightAccentBrush}" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="1" Spacing="8">
     <TextBlock x:Name="Heading" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <TextBlock x:Name="AchievementTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
