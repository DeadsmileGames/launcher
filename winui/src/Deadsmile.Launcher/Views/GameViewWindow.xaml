<Window x:Class="Deadsmile.Launcher.Views.GameViewWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DeadBar">
 <Grid x:Name="OverlayRoot" RequestedTheme="Dark" Background="Transparent">
  <Grid.Resources>
   <Style x:Key="Widget" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource WidgetBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/>
   </Style>
  </Grid.Resources>
  <Canvas x:Name="WidgetCanvas">
<Border x:Name="ProfilePanel" Tag="Profile" Style="{StaticResource Widget}" Width="300" Height="280">
   <Grid><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Tag="Profile" Background="{ThemeResource WidgetHeaderBrush}" Padding="12,0,4,0" ColumnSpacing="8" CornerRadius="8,8,0,0"
     PointerPressed="WidgetPointerPressed" PointerMoved="WidgetPointerMoved" PointerReleased="WidgetPointerReleased" PointerCanceled="WidgetPointerReleased" PointerCaptureLost="WidgetPointerReleased">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <SymbolIcon Symbol="Contact" Width="16" Height="16"/>
     <TextBlock x:Name="ProfileHeading" Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
     <ToggleButton x:Name="ProfilePin" Tag="Profile" Grid.Column="2" Width="32" Height="32" Padding="4"><SymbolIcon Symbol="Pin"/></ToggleButton>
     <Button Tag="Profile" Grid.Column="3" Style="{StaticResource SubtleButtonStyle}" Width="32" Height="32" Padding="4" Click="CloseWidget"><SymbolIcon Symbol="Cancel"/></Button>
    </Grid>
    <ScrollViewer Grid.Row="1" Padding="16" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="12"><PersonPicture x:Name="ProfileAvatar" Width="48" Height="48" HorizontalAlignment="Left"/><TextBlock x:Name="UserLabel" Style="{StaticResource BodyStrongTextBlockStyle}"/><TextBlock x:Name="PlayingLabel" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel></ScrollViewer>
   </Grid>
  </Border>
<Border x:Name="LibraryPanel" Tag="Library" Style="{StaticResource Widget}" Width="300" Height="280">
   <Grid><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Tag="Library" Background="{ThemeResource WidgetHeaderBrush}" Padding="12,0,4,0" ColumnSpacing="8" CornerRadius="8,8,0,0"
     PointerPressed="WidgetPointerPressed" PointerMoved="WidgetPointerMoved" PointerReleased="WidgetPointerReleased" PointerCanceled="WidgetPointerReleased" PointerCaptureLost="WidgetPointerReleased">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <SymbolIcon Symbol="Library" Width="16" Height="16"/>
     <TextBlock x:Name="LibraryHeading" Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
     <ToggleButton x:Name="LibraryPin" Tag="Library" Grid.Column="2" Width="32" Height="32" Padding="4"><SymbolIcon Symbol="Pin"/></ToggleButton>
     <Button Tag="Library" Grid.Column="3" Style="{StaticResource SubtleButtonStyle}" Width="32" Height="32" Padding="4" Click="CloseWidget"><SymbolIcon Symbol="Cancel"/></Button>
    </Grid>
    <ScrollViewer Grid.Row="1" Padding="16" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="LibraryRows" Spacing="8"/></ScrollViewer>
   </Grid>
  </Border>
<Border x:Name="AchievementsPanel" Tag="Achievements" Style="{StaticResource Widget}" Width="300" Height="280">
   <Grid><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Tag="Achievements" Background="{ThemeResource WidgetHeaderBrush}" Padding="12,0,4,0" ColumnSpacing="8" CornerRadius="8,8,0,0"
     PointerPressed="WidgetPointerPressed" PointerMoved="WidgetPointerMoved" PointerReleased="WidgetPointerReleased" PointerCanceled="WidgetPointerReleased" PointerCaptureLost="WidgetPointerReleased">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <SymbolIcon Symbol="Favorite" Width="16" Height="16"/>
     <TextBlock x:Name="AchievementsHeading" Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
     <ToggleButton x:Name="AchievementsPin" Tag="Achievements" Grid.Column="2" Width="32" Height="32" Padding="4"><SymbolIcon Symbol="Pin"/></ToggleButton>
     <Button Tag="Achievements" Grid.Column="3" Style="{StaticResource SubtleButtonStyle}" Width="32" Height="32" Padding="4" Click="CloseWidget"><SymbolIcon Symbol="Cancel"/></Button>
    </Grid>
    <ScrollViewer Grid.Row="1" Padding="16" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="AchievementRows" Spacing="12"/></ScrollViewer>
   </Grid>
  </Border>
<Border x:Name="CloudPanel" Tag="Cloud" Style="{StaticResource Widget}" Width="300" Height="280">
   <Grid><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Tag="Cloud" Background="{ThemeResource WidgetHeaderBrush}" Padding="12,0,4,0" ColumnSpacing="8" CornerRadius="8,8,0,0"
     PointerPressed="WidgetPointerPressed" PointerMoved="WidgetPointerMoved" PointerReleased="WidgetPointerReleased" PointerCanceled="WidgetPointerReleased" PointerCaptureLost="WidgetPointerReleased">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <SymbolIcon Symbol="Save" Width="16" Height="16"/>
     <TextBlock x:Name="CloudHeading" Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
     <ToggleButton x:Name="CloudPin" Tag="Cloud" Grid.Column="2" Width="32" Height="32" Padding="4"><SymbolIcon Symbol="Pin"/></ToggleButton>
     <Button Tag="Cloud" Grid.Column="3" Style="{StaticResource SubtleButtonStyle}" Width="32" Height="32" Padding="4" Click="CloseWidget"><SymbolIcon Symbol="Cancel"/></Button>
    </Grid>
    <ScrollViewer Grid.Row="1" Padding="16" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="CloudRows" Spacing="12"/></ScrollViewer>
   </Grid>
  </Border>
<Border x:Name="CapturePanel" Tag="Capture" Style="{StaticResource Widget}" Width="300" Height="280">
   <Grid><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Tag="Capture" Background="{ThemeResource WidgetHeaderBrush}" Padding="12,0,4,0" ColumnSpacing="8" CornerRadius="8,8,0,0"
     PointerPressed="WidgetPointerPressed" PointerMoved="WidgetPointerMoved" PointerReleased="WidgetPointerReleased" PointerCanceled="WidgetPointerReleased" PointerCaptureLost="WidgetPointerReleased">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <SymbolIcon Symbol="Camera" Width="16" Height="16"/>
     <TextBlock x:Name="CaptureHeading" Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
     <ToggleButton x:Name="CapturePin" Tag="Capture" Grid.Column="2" Width="32" Height="32" Padding="4"><SymbolIcon Symbol="Pin"/></ToggleButton>
     <Button Tag="Capture" Grid.Column="3" Style="{StaticResource SubtleButtonStyle}" Width="32" Height="32" Padding="4" Click="CloseWidget"><SymbolIcon Symbol="Cancel"/></Button>
    </Grid>
    <ScrollViewer Grid.Row="1" Padding="16" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="16"><Button x:Name="CaptureButton" Content="Take screenshot" HorizontalAlignment="Stretch" Click="CaptureClick"/>
     <Button x:Name="ShareCaptureButton" Content="Share screenshot" HorizontalAlignment="Stretch" IsEnabled="False" Click="ShareCaptureClick"/>
     <TextBlock x:Name="CaptureStatus" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"/></StackPanel></ScrollViewer>
   </Grid>
  </Border>
</Canvas>
  <Border x:Name="ToolbarPanel" Style="{StaticResource Widget}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,20,16,0" Padding="8">
   <StackPanel Orientation="Horizontal" Spacing="4">
    <Image Source="ms-appx:///Assets/Square44x44Logo.png" Width="24" Height="24" Margin="8,0"/>
    <TextBlock x:Name="ClockLabel" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" Margin="8,0,12,0"/>
    <ToggleButton x:Name="ProfileToggle" Tag="Profile" IsChecked="True" Click="WidgetToggled"><SymbolIcon Symbol="Contact"/></ToggleButton>
    <ToggleButton x:Name="LibraryToggle" Tag="Library" IsChecked="True" Click="WidgetToggled"><SymbolIcon Symbol="Library"/></ToggleButton>
    <ToggleButton x:Name="AchievementsToggle" Tag="Achievements" IsChecked="True" Click="WidgetToggled"><SymbolIcon Symbol="Favorite"/></ToggleButton>
    <ToggleButton x:Name="CloudToggle" Tag="Cloud" IsChecked="True" Click="WidgetToggled"><SymbolIcon Symbol="Save"/></ToggleButton>
    <ToggleButton x:Name="CaptureToggle" Tag="Capture" IsChecked="True" Click="WidgetToggled"><SymbolIcon Symbol="Camera"/></ToggleButton>
    <AppBarSeparator/>
    <Button x:Name="ReloadButton" Style="{StaticResource SubtleButtonStyle}" Click="ReloadClick"><SymbolIcon Symbol="Refresh"/></Button>
    <Button x:Name="LayoutButton" Style="{StaticResource SubtleButtonStyle}" Click="ResetLayoutClick"><SymbolIcon Symbol="ViewAll"/></Button>
    <TextBlock x:Name="ShortcutLabel" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="8,0"/>
    <Button x:Name="CloseButton" Style="{StaticResource SubtleButtonStyle}" Click="CloseClick"><SymbolIcon Symbol="Cancel"/></Button>
   </StackPanel>
  </Border>
 </Grid>
</Window>
