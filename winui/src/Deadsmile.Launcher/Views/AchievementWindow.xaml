<Window x:Class="Deadsmile.Launcher.Views.AchievementWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid x:Name="ToastRoot" RequestedTheme="Dark" Background="{ThemeResource WidgetBrush}">
  <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="24" CornerRadius="8">
   <Grid ColumnSpacing="20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Viewbox Width="32" Height="32" VerticalAlignment="Center"><SymbolIcon Symbol="Favorite" Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/></Viewbox>
    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
     <TextBlock x:Name="Heading" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"/>
     <TextBlock x:Name="AchievementTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
