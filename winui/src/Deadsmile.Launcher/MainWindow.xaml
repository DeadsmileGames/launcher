<Window x:Class="Deadsmile.Launcher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Deadsmile Games Launcher">
 <Grid x:Name="Root" RequestedTheme="Dark" Background="{StaticResource BaseBrush}">
  <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="TitleDrag" Background="Black" Padding="20,0,150,0">
   <TextBlock Text="Deadsmile Games Launcher" FontSize="13" VerticalAlignment="Center"/>
  </Grid>
  <Grid x:Name="BootPanel" Grid.Row="1"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
   <ProgressRing IsActive="True"/><TextBlock Text="Loading…" Tag="Loading…"/>
  </StackPanel></Grid>
  <Grid x:Name="LoginPanel" Grid.Row="1" Visibility="Collapsed">
   <Image Source="Assets/Login.png" Stretch="UniformToFill" Opacity="0.55"/>
   <Rectangle Fill="#85000000"/>
   <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid MinHeight="600" Padding="32">
    <Border MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#EF181818"
      CornerRadius="10" Padding="36" BorderBrush="#555555" BorderThickness="1">
     <StackPanel Spacing="18">
      <Image Source="Assets/Brand.svg" Height="66" HorizontalAlignment="Center"/>
      <TextBlock x:Name="LoginHeading" Text="Sign in" Tag="Sign in" Style="{StaticResource Heading}"/>
      <InfoBar x:Name="LoginError" IsOpen="False" Severity="Error" IsClosable="True"/>
      <StackPanel x:Name="CredentialsPanel" Spacing="16">
       <TextBox x:Name="EmailBox" Header="Email" PlaceholderText="Email" MaxLength="254" InputScope="EmailSmtpAddress"/>
       <PasswordBox x:Name="PasswordBox" Header="Password" MaxLength="512" KeyDown="LoginKeyDown"/>
      </StackPanel>
      <TextBox x:Name="CodeBox" Header="Authentication code" MaxLength="16" Visibility="Collapsed" KeyDown="LoginKeyDown"/>
      <Button x:Name="LoginButton" Content="Sign in" Tag="Sign in" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Click="LoginClick"/>
      <Button x:Name="LoginBackButton" Content="Back" Tag="Back" Visibility="Collapsed" Click="LoginBackClick"/>
      <Button x:Name="ResendButton" Content="Resend verification email" Tag="Resend verification email" Visibility="Collapsed" Click="ResendClick"/>
      <Button Content="Create account" Tag="Create account" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Stretch" Click="RegisterClick"/>
      <HyperlinkButton Content="Forgot password?" Tag="Forgot password?" Click="ForgotClick"/>
      <ComboBox x:Name="LoginLanguage" Header="Language" SelectionChanged="LanguageChanged" HorizontalAlignment="Stretch">
       <ComboBoxItem Content="Português" Tag="pt-BR"/><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="Español" Tag="es"/>
      </ComboBox>
     </StackPanel>
    </Border>
   </Grid></ScrollViewer>
  </Grid>
  <Grid x:Name="Shell" Grid.Row="1" Visibility="Collapsed">
   <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#141414" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="18,28,18,20">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel x:Name="Navigation" Spacing="10">
      <Button Style="{StaticResource NavButton}" Tag="explore" Click="NavigateClick"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE721;"/><TextBlock Text="Explore" Tag="Explore"/></StackPanel></Button>
      <Button Style="{StaticResource NavButton}" Tag="library" Click="NavigateClick"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE7FC;"/><TextBlock Text="Library" Tag="Library"/></StackPanel></Button>
      <Button Style="{StaticResource NavButton}" Tag="downloads" Click="NavigateClick"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE896;"/><TextBlock x:Name="DownloadsLabel" Text="Downloads" Tag="Downloads"/></StackPanel></Button>
      <Button Style="{StaticResource NavButton}" Tag="settings" Click="NavigateClick"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE713;"/><TextBlock Text="Settings" Tag="Settings"/></StackPanel></Button>
     </StackPanel>
     <StackPanel Grid.Row="2" Spacing="14">
      <Button Content="Website" Tag="Website" Style="{StaticResource NavButton}" Click="WebsiteClick"/>
      <StackPanel Orientation="Horizontal" Spacing="10"><PersonPicture x:Name="Avatar" Width="36" Height="36"/><TextBlock x:Name="Username" VerticalAlignment="Center" MaxWidth="118"/></StackPanel>
      <Button x:Name="LogoutButton" Content="Sign out" Tag="Sign out" Style="{StaticResource NavButton}" Click="LogoutClick"/>
     </StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Column="1" Padding="30,24,30,24" RowSpacing="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <InfoBar x:Name="Notice" IsClosable="True"/>
    <Grid Grid.Row="1" ColumnSpacing="16">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" Spacing="16">
      <Button x:Name="BackButton" Content="Back" Tag="Back" Visibility="Collapsed" Click="BackClick"/>
      <TextBlock x:Name="PageHeading" Text="Explore" Style="{StaticResource Heading}" VerticalAlignment="Center"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
      <ProgressRing x:Name="BusyRing" Width="24" Height="24" IsActive="False"/>
      <Button x:Name="RefreshButton" Content="Refresh" Tag="Refresh" Click="RefreshClick"/>
     </StackPanel>
    </Grid>
    <Grid Grid.Row="2">
     <Grid x:Name="CatalogPanel" RowSpacing="20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search games" QueryIcon="Find" TextChanged="SearchChanged"/>
       <CheckBox x:Name="InstalledFilter" Grid.Column="1" Content="Installed only" VerticalAlignment="Center" Checked="FilterChanged" Unchecked="FilterChanged"/>
      </Grid>
      <GridView x:Name="GameGrid" Grid.Row="1" IsItemClickEnabled="True" SelectionMode="None" ItemClick="GameClick"
        HorizontalContentAlignment="Stretch" Padding="0,0,0,12">
       <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid ItemWidth="250" Orientation="Horizontal"/></ItemsPanelTemplate></GridView.ItemsPanel>
       <GridView.ItemTemplate><DataTemplate>
        <Border Background="#181818" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Width="234" Margin="0,0,12,16">
         <StackPanel>
          <Grid Height="132"><Rectangle Fill="#292929"/><FontIcon Glyph="&#xE7FC;" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#888888"/><Image Source="{Binding Cover}" Stretch="UniformToFill"/></Grid>
          <StackPanel Padding="16" Spacing="8">
           <TextBlock Text="{Binding Title}" FontFamily="{StaticResource DisplayFont}" FontSize="21" MaxLines="2" TextTrimming="CharacterEllipsis"/>
           <TextBlock Text="{Binding Genres}" FontSize="12" Foreground="{StaticResource MutedBrush}" MaxLines="1" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
         </StackPanel>
        </Border>
       </DataTemplate></GridView.ItemTemplate>
      </GridView>
      <TextBlock x:Name="EmptyCatalog" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
     </Grid>
     <ScrollViewer x:Name="DetailPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="DetailContent" Spacing="28" Padding="0,0,8,28"/>
     </ScrollViewer>
     <ScrollViewer x:Name="DownloadsPanel" Visibility="Collapsed"><StackPanel x:Name="DownloadRows" Spacing="16"/></ScrollViewer>
     <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed">
      <StackPanel Spacing="22" MaxWidth="720" HorizontalAlignment="Left">
       <Border Style="{StaticResource Panel}"><StackPanel Spacing="16">
        <TextBlock Text="Language" Tag="Language" FontSize="24" FontFamily="{StaticResource DisplayFont}"/>
        <ComboBox x:Name="SettingsLanguage" SelectionChanged="LanguageChanged" Width="280">
         <ComboBoxItem Content="Português" Tag="pt-BR"/><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="Español" Tag="es"/>
        </ComboBox>
       </StackPanel></Border>
       <Border Style="{StaticResource Panel}"><StackPanel Spacing="16">
        <TextBlock x:Name="ItchStatus" Text="Connect itch.io to sync purchased games."/>
        <Button x:Name="ItchButton" Content="Connect itch.io" Click="ItchClick" Style="{StaticResource SecondaryButton}"/>
       </StackPanel></Border>
       <Border Style="{StaticResource Panel}"><StackPanel Spacing="16">
        <TextBlock Text="Game View" FontSize="24" FontFamily="{StaticResource DisplayFont}"/>
        <ToggleSwitch x:Name="OverlayToggle" Header="Game View" Toggled="OverlayToggled" IsOn="True"/>
        <TextBlock Text="Ctrl + D" Foreground="{StaticResource MutedBrush}"/>
        <Button Content="Open games folder" Tag="Open games folder" Click="OpenGamesClick"/>
       </StackPanel></Border>
       <Border Style="{StaticResource Panel}"><StackPanel Spacing="16">
        <TextBlock x:Name="VersionLabel" Text="Deadsmile Games Launcher" FontSize="24" FontFamily="{StaticResource DisplayFont}"/>
        <Button x:Name="UpdateButton" Content="Check for updates" Tag="Check for updates" Click="UpdateClick"/>
       </StackPanel></Border>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Grid>
  </Grid>
 </Grid>
</Window>
