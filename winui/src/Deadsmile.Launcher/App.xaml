<Application x:Class="Deadsmile.Launcher.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/></ResourceDictionary.MergedDictionaries>
  <FontFamily x:Key="DisplayFont">ms-appx:///Assets/Fonts/Berlin-Sans-FB-Demi-Bold.ttf#Berlin Sans FB Demi</FontFamily>
  <FontFamily x:Key="BodyFont">ms-appx:///Assets/Fonts/gadugi-bold.ttf#Gadugi</FontFamily>
  <SolidColorBrush x:Key="BaseBrush" Color="#0F0F0F"/><SolidColorBrush x:Key="SurfaceBrush" Color="#202020"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#B8B8B8"/><SolidColorBrush x:Key="BorderBrush" Color="#3D3D3D"/>
  <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource BodyFont}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/><Setter Property="FontSize" Value="32"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="PrimaryButton" TargetType="Button">
   <Setter Property="Background" Value="#F0F0F0"/><Setter Property="Foreground" Value="#141414"/>
   <Setter Property="BorderBrush" Value="#707070"/><Setter Property="BorderThickness" Value="0,0,0,4"/>
   <Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="22,12"/>
   <Setter Property="MinHeight" Value="48"/><Setter Property="FontFamily" Value="{StaticResource BodyFont}"/><Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style x:Key="SecondaryButton" TargetType="Button">
   <Setter Property="Background" Value="#111111"/><Setter Property="Foreground" Value="#EEEEEE"/>
   <Setter Property="BorderBrush" Value="#777777"/><Setter Property="BorderThickness" Value="1,1,1,4"/>
   <Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="20,12"/><Setter Property="MinHeight" Value="48"/><Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
  </Style>
  <Style x:Key="NavButton" TargetType="Button">
   <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="MinHeight" Value="48"/><Setter Property="FontFamily" Value="{StaticResource BodyFont}"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,10"/><Setter Property="CornerRadius" Value="6"/>
  </Style>
  <Style x:Key="Panel" TargetType="Border">
   <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="24"/>
  </Style>
 </ResourceDictionary></Application.Resources>
</Application>
