<Window x:Class="Deadsmile.Launcher.Views.AchievementWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid x:Name="ToastRoot" RequestedTheme="Dark" Background="#FF202020">
  <Border Background="#FF242424" BorderBrush="#FF454545" BorderThickness="1" Padding="16" CornerRadius="16">
   <Grid ColumnSpacing="20">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Viewbox Width="28" Height="28" VerticalAlignment="Center"><SymbolIcon x:Name="ToastIcon" Symbol="Favorite" Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/></Viewbox>
    <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
     <TextBlock x:Name="Heading" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"/>
     <TextBlock x:Name="AchievementTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
