<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><LangVersion>latest</LangVersion>
    <Version>1.0.0</Version><AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Deterministic>true</Deterministic><DebugType>portable</DebugType>
    <NuGetAudit>true</NuGetAudit><NuGetAuditLevel>high</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>
</Project>
