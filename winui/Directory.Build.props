<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><LangVersion>latest</LangVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>1.0.1</Version><AssemblyVersion>$(Version).0</AssemblyVersion>
    <Deterministic>true</Deterministic><DebugType>portable</DebugType>
    <NuGetAudit>true</NuGetAudit><NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1900;NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>
</Project>
