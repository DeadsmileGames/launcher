<Window x:Class="Deadsmile.Launcher.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Deadsmile Games Launcher">
 <Grid x:Name="Root" RequestedTheme="Dark" Background="{ThemeResource BaseBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <TitleBar x:Name="AppTitleBar" Title="Deadsmile Games Launcher" Background="{ThemeResource SidebarBrush}"
   IsPaneToggleButtonVisible="False" IsBackButtonVisible="False" IsBackButtonEnabled="False"
   BackRequested="TitleBackRequested" PaneToggleRequested="TitlePaneToggleRequested">
   <TitleBar.IconSource><BitmapIconSource UriSource="ms-appx:///Assets/Square44x44Logo.png" ShowAsMonochrome="False"/></TitleBar.IconSource>
   <TitleBar.Content>
    <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search games" QueryIcon="Find" MinWidth="180" MaxWidth="600"
     HorizontalAlignment="Stretch" Visibility="Collapsed" TextChanged="SearchChanged" QuerySubmitted="SearchSubmitted"
     AutomationProperties.AutomationId="GlobalSearch" AutomationProperties.Name="Search games"/>
   </TitleBar.Content>
   <TitleBar.RightHeader>
    <Button x:Name="AccountButton" Style="{StaticResource SubtleButtonStyle}" Padding="4" Visibility="Collapsed"
     AutomationProperties.Name="Account" AutomationProperties.AutomationId="AccountMenu">
     <PersonPicture x:Name="Avatar" Width="28" Height="28"/>
     <Button.Flyout><MenuFlyout>
      <MenuFlyoutItem x:Name="Username" Text="Account" IsEnabled="False"/>
      <MenuFlyoutSeparator/>
      <MenuFlyoutItem x:Name="WebsiteMenuItem" Text="Website" Click="WebsiteClick"><MenuFlyoutItem.Icon><SymbolIcon Symbol="World"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
      <MenuFlyoutItem x:Name="LogoutButton" Text="Sign out" Click="LogoutClick"><MenuFlyoutItem.Icon><SymbolIcon Symbol="LeaveChat"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
     </MenuFlyout></Button.Flyout>
    </Button>
   </TitleBar.RightHeader>
  </TitleBar>
  <Grid x:Name="BootPanel" Grid.Row="1"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
   <ProgressRing IsActive="True"/><TextBlock Text="Loading…" Tag="Loading…" Style="{StaticResource BodyTextBlockStyle}"/>
  </StackPanel></Grid>
  <ScrollViewer x:Name="LoginPanel" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
   <Grid x:Name="LoginLayout" Padding="24" MinHeight="500">
    <StackPanel Width="360" MaxWidth="360" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24">
     <StackPanel Spacing="8">
      <TextBlock x:Name="LoginHeading" Text="Sign in" Tag="Sign in" Style="{StaticResource TitleTextBlockStyle}"/>
      <TextBlock Text="Deadsmile Games" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     </StackPanel>
     <InfoBar x:Name="LoginError" IsOpen="False" Severity="Error" IsClosable="True"/>
     <StackPanel x:Name="CredentialsPanel" Spacing="16">
      <TextBox x:Name="EmailBox" Header="Email or username" MaxLength="254" KeyDown="LoginKeyDown"
       AutomationProperties.AutomationId="LoginEmail"/>
      <PasswordBox x:Name="PasswordBox" Header="Password" MaxLength="512" KeyDown="LoginKeyDown"
       AutomationProperties.AutomationId="LoginPassword"/>
     </StackPanel>
     <TextBox x:Name="CodeBox" Header="Authentication code" MaxLength="16" Visibility="Collapsed" KeyDown="LoginKeyDown"/>
     <StackPanel Spacing="12">
      <Button x:Name="LoginButton" Content="Sign in" Tag="Sign in" Style="{StaticResource AccentButtonStyle}"
       HorizontalAlignment="Stretch" Click="LoginClick" AutomationProperties.AutomationId="SignIn"/>
      <Button x:Name="LoginBackButton" Content="Back" Tag="Back" Visibility="Collapsed" HorizontalAlignment="Stretch" Click="LoginBackClick"/>
      <Button x:Name="ResendButton" Content="Resend verification email" Tag="Resend verification email" Visibility="Collapsed"
       HorizontalAlignment="Stretch" Click="ResendClick"/>
      <HyperlinkButton Content="Forgot password?" Tag="Forgot password?" Click="ForgotClick" Padding="0,4"/>
      <HyperlinkButton Content="Create account" Tag="Create account" Click="RegisterClick" Padding="0,4"/>
     </StackPanel>
     <ComboBox x:Name="LoginLanguage" Header="Language" SelectionChanged="LanguageChanged" HorizontalAlignment="Stretch">
      <ComboBoxItem Content="Português" Tag="pt-BR"/><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="Español" Tag="es"/>
     </ComboBox>
    </StackPanel>
   </Grid>
  </ScrollViewer>
  <NavigationView x:Name="Shell" Grid.Row="1" Visibility="Collapsed" PaneDisplayMode="LeftCompact"
   CompactPaneLength="72" OpenPaneLength="280" IsPaneOpen="False" IsPaneToggleButtonVisible="False"
   IsBackButtonVisible="Collapsed" IsSettingsVisible="True" AlwaysShowHeader="False"
   Background="{ThemeResource SidebarBrush}" SelectionChanged="NavigationChanged">
   <NavigationView.MenuItems>
    <NavigationViewItem x:Name="ExploreItem" Content="Explore" Tag="explore" AutomationProperties.AutomationId="ExploreNavigation">
     <NavigationViewItem.Icon><SymbolIcon Symbol="Home"/></NavigationViewItem.Icon>
    </NavigationViewItem>
   </NavigationView.MenuItems>
   <NavigationView.FooterMenuItems>
    <NavigationViewItem x:Name="DownloadsItem" Content="Downloads" Tag="downloads" AutomationProperties.AutomationId="DownloadsNavigation">
     <NavigationViewItem.Icon><SymbolIcon Symbol="Download"/></NavigationViewItem.Icon>
    </NavigationViewItem>
    <NavigationViewItem x:Name="LibraryItem" Content="Library" Tag="library" AutomationProperties.AutomationId="LibraryNavigation">
     <NavigationViewItem.Icon><SymbolIcon Symbol="Library"/></NavigationViewItem.Icon>
    </NavigationViewItem>
   </NavigationView.FooterMenuItems>
   <Grid x:Name="PageLayout" Background="{ThemeResource BaseBrush}" Padding="24,16,24,24" RowSpacing="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <InfoBar x:Name="Notice" IsClosable="True"/>
    <Grid x:Name="PageToolbar" Grid.Row="1" ColumnSpacing="16">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="PageHeading" Text="Explore" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
     <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
      <ProgressRing x:Name="BusyRing" Width="20" Height="20" IsActive="False"/>
      <Button x:Name="RefreshButton" Content="Refresh" Tag="Refresh" Click="RefreshClick"/>
     </StackPanel>
    </Grid>
    <Grid Grid.Row="2">
     <Grid x:Name="CatalogPanel">
      <GridView x:Name="GameGrid" IsItemClickEnabled="True" SelectionMode="None" ItemClick="GameClick"
       HorizontalContentAlignment="Stretch" Padding="0,0,0,16" AutomationProperties.AutomationId="GameCatalog">
       <GridView.Header>
        <StackPanel x:Name="CatalogHeader" Spacing="24" Margin="0,0,0,16">
         <Grid x:Name="FeaturedPanel" Height="340" Visibility="Collapsed" ColumnSpacing="12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.6*"/><ColumnDefinition x:Name="FeaturedSideColumn" Width="*"/></Grid.ColumnDefinitions>
          <Grid CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
           <Image x:Name="FeaturedImage" Stretch="UniformToFill"/>
           <Border CornerRadius="8">
            <Border.Background><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#E6000000" Offset="0"/><GradientStop Color="#80000000" Offset="0.65"/><GradientStop Color="#40000000" Offset="1"/></LinearGradientBrush></Border.Background>
            <StackPanel Padding="32" Spacing="12" VerticalAlignment="Bottom" MaxWidth="620" HorizontalAlignment="Left">
             <TextBlock x:Name="FeaturedTitle" Style="{StaticResource TitleLargeTextBlockStyle}" TextWrapping="Wrap" MaxLines="2"/>
             <TextBlock x:Name="FeaturedGenres" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" MaxLines="2" Foreground="White"/>
             <Button x:Name="FeaturedButton" Content="View details" Style="{StaticResource AccentButtonStyle}" Click="FeaturedClick" Margin="0,8,0,0"/>
            </StackPanel>
           </Border>
          </Grid>
          <Grid x:Name="FeaturedSide" Grid.Column="1" RowSpacing="12">
           <Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
           <Button x:Name="SecondaryFeature" Tag="0" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Click="SecondaryFeaturedClick">
            <Grid><Image x:Name="SecondaryFeaturedImage" Stretch="UniformToFill"/><Border Background="#60000000"/>
             <TextBlock x:Name="SecondaryFeaturedTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Bottom" Margin="24"/>
            </Grid>
           </Button>
           <Grid Grid.Row="1" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Button x:Name="ThirdFeature" Tag="1" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Click="SecondaryFeaturedClick">
             <Grid><Image x:Name="ThirdFeaturedImage" Stretch="UniformToFill"/><Border Background="#60000000"/>
              <TextBlock x:Name="ThirdFeaturedTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Bottom" Margin="16"/>
             </Grid>
            </Button>
            <Button x:Name="FourthFeature" Grid.Column="1" Tag="2" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Click="SecondaryFeaturedClick">
             <Grid><Image x:Name="FourthFeaturedImage" Stretch="UniformToFill"/><Border Background="#60000000"/>
              <TextBlock x:Name="FourthFeaturedTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Bottom" Margin="16"/>
             </Grid>
            </Button>
           </Grid>
          </Grid>
         </Grid>
         <CheckBox x:Name="InstalledFilter" Content="Installed only" Checked="FilterChanged" Unchecked="FilterChanged"/>
        </StackPanel>
       </GridView.Header>
       <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid x:Name="CatalogWrap" ItemWidth="244" Orientation="Horizontal"/></ItemsPanelTemplate></GridView.ItemsPanel>
       <GridView.ItemTemplate><DataTemplate>
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
         BorderThickness="1" CornerRadius="8" Width="228" Margin="0,0,8,16" AutomationProperties.Name="{Binding Title}">
         <StackPanel>
          <Grid Height="140" CornerRadius="7,7,0,0" Background="{ThemeResource ControlFillColorSecondaryBrush}">
           <SymbolIcon Symbol="Play" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
           <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
          </Grid>
          <StackPanel Padding="16" Spacing="8">
           <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" MinHeight="40"/>
           <TextBlock Text="{Binding Genres}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="1" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
         </StackPanel>
        </Border>
       </DataTemplate></GridView.ItemTemplate>
      </GridView>
      <TextBlock x:Name="EmptyCatalog" Style="{StaticResource BodyTextBlockStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
     </Grid>
     <ScrollViewer x:Name="DetailPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="DetailContent" Spacing="16" Padding="0,0,8,24"/>
     </ScrollViewer>
     <ScrollViewer x:Name="DownloadsPanel" Visibility="Collapsed"><StackPanel x:Name="DownloadRows" Spacing="12" Padding="0,0,8,24"/></ScrollViewer>
     <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed">
      <StackPanel Spacing="24" MaxWidth="1000" HorizontalAlignment="Stretch" Padding="0,0,8,24">
       <StackPanel Spacing="12">
        <TextBlock Text="Language" Tag="Language" Style="{StaticResource SubtitleTextBlockStyle}"/>
        <Border Style="{StaticResource Panel}"><Grid ColumnSpacing="24">
         <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <SymbolIcon Symbol="Font" VerticalAlignment="Center"/>
         <TextBlock Grid.Column="1" Text="Language" Tag="Language" Style="{StaticResource BodyTextBlockStyle}" VerticalAlignment="Center"/>
         <ComboBox x:Name="SettingsLanguage" Grid.Column="2" SelectionChanged="LanguageChanged" Width="220">
          <ComboBoxItem Content="Português" Tag="pt-BR"/><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="Español" Tag="es"/>
         </ComboBox>
        </Grid></Border>
       </StackPanel>
       <StackPanel Spacing="12">
        <TextBlock Text="Account" Tag="Account" Style="{StaticResource SubtitleTextBlockStyle}"/>
        <Border Style="{StaticResource Panel}"><StackPanel Spacing="16">
         <TextBlock x:Name="ItchStatus" Text="Connect itch.io to sync purchased games." TextWrapping="Wrap"/>
         <Button x:Name="ItchButton" Content="Connect itch.io" Click="ItchClick"/>
        </StackPanel></Border>
       </StackPanel>
       <StackPanel Spacing="12">
        <TextBlock Text="Game View" Style="{StaticResource SubtitleTextBlockStyle}"/>
        <Border Style="{StaticResource Panel}"><Grid ColumnSpacing="24">
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel Spacing="8"><TextBlock Text="Game View"/><TextBlock x:Name="ShortcutText" Text="Ctrl + D" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
         <ToggleSwitch x:Name="OverlayToggle" Grid.Column="1" Header="Game View" Toggled="OverlayToggled" IsOn="True"/>
        </Grid></Border>
        <Button Content="Open games folder" Tag="Open games folder" Click="OpenGamesClick"/>
       </StackPanel>
       <StackPanel Spacing="12">
        <TextBlock Text="About" Tag="About" Style="{StaticResource SubtitleTextBlockStyle}"/>
        <Border Style="{StaticResource Panel}"><StackPanel Spacing="16">
         <TextBlock x:Name="VersionLabel" Text="Deadsmile Games Launcher" Style="{StaticResource BodyStrongTextBlockStyle}"/>
         <Button x:Name="UpdateButton" Content="Check for updates" Tag="Check for updates" Click="UpdateClick"/>
        </StackPanel></Border>
       </StackPanel>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Grid>
  </NavigationView>
 </Grid>
</Window>
